# このファイルを .env にコピーして値を入れてください
ANTHROPIC_API_KEY=sk-ant-...

# 任意設定
# モデル: claude-sonnet-5-5（既定） / claude-opus-5-5（高性能） / claude-haiku-5-5（最安）
# JARVIS_MODEL=claude-sonnet-5-5
# 考える深さ: low（既定） / medium / high / xhigh / max
# JARVIS_EFFORT=low
# JARVIS_USER_NAME=
# 会話からの自動記憶: on（既定） / off。会話開始時に思い出す過去の会話の数
# JARVIS_AUTO_MEMORY=on
# JARVIS_RECALL_CONVERSATIONS=5
# GUI 版のポート番号
# JARVIS_PORT=8765
# 「Hey Jarvis」呼びかけ検知: on（既定） / off
# JARVIS_WAKEWORD=on
# 検知の厳しさ（0〜1）。上げると誤反応が減り、下げると反応しやすくなる
# JARVIS_WAKEWORD_THRESHOLD=0.5
# VOICEVOX の声の番号（47 = ナースロボ＿タイプＴ ノーマル（既定）、48 = 楽々、49 = 恐怖、50 = 内緒話、2 = 四国めたん ノーマル）と話す速さ
# JARVIS_VOICEVOX_SPEAKER=47
# JARVIS_VOICEVOX_SPEED=1.2
