# このファイルを .env にコピーして値を入れてください
ANTHROPIC_API_KEY=sk-ant-...

# 任意設定
# 普段の会話のモデルと、込み入った依頼で切り替える上位モデル（JARVIS_SMART_MODEL を空にすると切り替えない）
# モデル: claude-haiku-5-5（最安） / claude-sonnet-5-5（バランス） / claude-opus-5-5（高性能）
# JARVIS_MODEL=claude-haiku-5-5
# JARVIS_SMART_MODEL=claude-sonnet-5-5
# 考える深さ: low（既定） / medium / high / xhigh / max
# JARVIS_EFFORT=low
# JARVIS_USER_NAME=
# 会話からの自動記憶: on（既定） / off。毎回読み込む記憶の文書の合計文字数の目安
# JARVIS_AUTO_MEMORY=on
# JARVIS_MEMORY_BUDGET=8000
# 指定すると、この名前の Google カレンダーだけを読み書きする（連携は jarvis-google-setup.bat）
# JARVIS_GOOGLE_CALENDAR=
# GUI 版のポート番号
# JARVIS_PORT=8765
# 「Hey Jarvis」呼びかけ検知: on（既定） / off
# JARVIS_WAKEWORD=on
# 検知の厳しさ（0〜1）。上げると誤反応が減り、下げると反応しやすくなる
# JARVIS_WAKEWORD_THRESHOLD=0.5
# VOICEVOX の声の番号（47 = ナースロボ＿タイプＴ ノーマル（既定）、48 = 楽々、49 = 恐怖、50 = 内緒話、2 = 四国めたん ノーマル）と話す速さ
# JARVIS_VOICEVOX_SPEAKER=47
# JARVIS_VOICEVOX_SPEED=1.2
# 各文の話し始め・話し終わりの無音（秒）と、「、」などの間の長さの倍率
# JARVIS_VOICEVOX_PRE_SILENCE=0.1
# JARVIS_VOICEVOX_POST_SILENCE=0.1
# JARVIS_VOICEVOX_PAUSE_SCALE=1.0
